# 로컬 실행용. 복사해서 .env 로 쓰세요 (.env 는 커밋되지 않음)
# GitHub Actions 에서는 같은 이름으로 Repository secrets 에 등록합니다.

# Claude API (없으면 AI 요약 없이 기사 목록만 만듭니다)
# AI 요약: 비워 두면 SUPABASE_DATA_KEY 로 Supabase ai-summarize 함수를 경유
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# 네이버 검색 API (없으면 Google 뉴스 RSS 로 대체)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 텔레그램 알림 (없으면 전송 생략)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DASHBOARD_URL=https://byeongjaeyu.github.io/manddang/

# Supabase secret(service_role) 키 — 있으면 결과를 Supabase 에 저장, 없으면 data/ 로컬 파일
SUPABASE_DATA_KEY=
